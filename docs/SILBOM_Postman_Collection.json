{
  "info": {
    "name": "SILBOM Hito 2 — Backend auditado",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Configura username/password y tecnicoPassword en un entorno local. Credenciales vacías por diseño. Ejecutar en una API recién iniciada: se conservan límites de 20 escrituras/minuto. Los tickets históricos no se borran."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080/api/v1"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "tecnicoPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01. Preparar demo y leer catálogo público",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          }
        ],
        "url": "{{baseUrl}}/maquinas",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const tag = Array.from({length:4}, () => String.fromCharCode(65+Math.floor(Math.random()*26))).join(\"\");",
              "pm.collectionVariables.set(\"maquinaId\", \"EQ-\"+tag+\"-01\");",
              "pm.collectionVariables.set(\"usernameDemo\", \"demo-\"+Date.now());",
              "pm.collectionVariables.set(\"referenciaFalla\", \"FALLA-\"+Date.now());"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Escritura sin autenticación",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/maquinas",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Crear máquina",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/maquinas",
        "body": {
          "mode": "raw",
          "raw": "{\"id\": \"{{maquinaId}}\", \"nombre\": \"Máquina demostración\", \"area\": \"Taller de pruebas\", \"icono\": \"X\", \"horasOperativas\": 100.0, \"fallasCorrectivas\": 0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"MTBF no calculable\",()=>pm.expect(pm.response.json().mtbf).to.eql(null));"
            ]
          }
        }
      ]
    },
    {
      "name": "04. Consultar máquina",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          }
        ],
        "url": "{{baseUrl}}/maquinas/{{maquinaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05. Actualizar máquina",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/maquinas/{{maquinaId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Máquina demostración\", \"area\": \"Taller de pruebas\", \"icono\": \"X\", \"horasOperativas\": 100.0, \"fallasCorrectivas\": 0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06. Crear técnico",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tecnicos",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{usernameDemo}}\", \"nombre\": \"Técnico demo\", \"password\": \"{{tecnicoPassword}}\", \"rol\": \"TECNICO\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"tecnicoId\",pm.response.json().id);",
              "pm.test(\"Sin hash\",()=>pm.expect(pm.response.json()).not.to.have.property(\"passwordHash\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "07. Leer técnico",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          }
        ],
        "url": "{{baseUrl}}/tecnicos/{{tecnicoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08. Actualizar técnico",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tecnicos/{{tecnicoId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Técnico actualizado\", \"rol\": \"TECNICO\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09. Baja lógica de técnico sin bloqueos",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          }
        ],
        "url": "{{baseUrl}}/tecnicos/{{tecnicoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Técnico dado de baja no aparece",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          }
        ],
        "url": "{{baseUrl}}/tecnicos/{{tecnicoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Rechazar declaración de candado ausente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/bloqueos",
        "body": {
          "mode": "raw",
          "raw": "{\"maquinaId\": \"{{maquinaId}}\", \"tipoIntervencion\": \"CORRECTIVA\", \"motivo\": \"Prueba de falla compartida\", \"confirmacionCandadoDs594\": false, \"referenciaFalla\": \"{{referenciaFalla}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Registrar participante 1 de la misma falla",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/bloqueos",
        "body": {
          "mode": "raw",
          "raw": "{\"maquinaId\": \"{{maquinaId}}\", \"tipoIntervencion\": \"CORRECTIVA\", \"motivo\": \"Prueba de falla compartida\", \"confirmacionCandadoDs594\": true, \"referenciaFalla\": \"{{referenciaFalla}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"bloqueo1\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Registrar participante 2 de la misma falla",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/bloqueos",
        "body": {
          "mode": "raw",
          "raw": "{\"maquinaId\": \"{{maquinaId}}\", \"tipoIntervencion\": \"CORRECTIVA\", \"motivo\": \"Prueba de falla compartida\", \"confirmacionCandadoDs594\": true, \"referenciaFalla\": \"{{referenciaFalla}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"bloqueo2\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Dos bloqueos, una falla",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          }
        ],
        "url": "{{baseUrl}}/maquinas/{{maquinaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const m=pm.response.json();",
              "pm.test(\"Multi-LOTO y falla única\",()=>{pm.expect(m.bloqueosActivos).to.eql(2);pm.expect(m.fallasCorrectivas).to.eql(1);pm.expect(m.mtbf).to.eql(100);});"
            ]
          }
        }
      ]
    },
    {
      "name": "15. No borrar ticket activo",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          }
        ],
        "url": "{{baseUrl}}/bloqueos/{{bloqueo1}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "16. Liberar primer ticket",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          }
        ],
        "url": "{{baseUrl}}/bloqueos/{{bloqueo1}}/liberar"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "17. Sigue bloqueada",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          }
        ],
        "url": "{{baseUrl}}/maquinas/{{maquinaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Queda un bloqueo\",()=>{pm.expect(pm.response.json().bloqueada).to.eql(true);pm.expect(pm.response.json().bloqueosActivos).to.eql(1);});"
            ]
          }
        }
      ]
    },
    {
      "name": "18. No descontar dos veces",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          }
        ],
        "url": "{{baseUrl}}/bloqueos/{{bloqueo1}}/liberar"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "19. No borrar ticket histórico",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          }
        ],
        "url": "{{baseUrl}}/bloqueos/{{bloqueo1}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "20. Auditoría de creación y liberación",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          }
        ],
        "url": "{{baseUrl}}/bloqueos/{{bloqueo1}}/eventos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Eventos\",()=>pm.expect(pm.response.json().map(e=>e.accion)).to.eql([\"CREADO\",\"LIBERADO\"]));"
            ]
          }
        }
      ]
    },
    {
      "name": "21. Liberar último ticket",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          }
        ],
        "url": "{{baseUrl}}/bloqueos/{{bloqueo2}}/liberar"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "22. Sin bloqueos digitales activos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          }
        ],
        "url": "{{baseUrl}}/maquinas/{{maquinaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Sin bloqueos\",()=>{pm.expect(pm.response.json().bloqueada).to.eql(false);pm.expect(pm.response.json().bloqueosActivos).to.eql(0);});"
            ]
          }
        }
      ]
    },
    {
      "name": "23. Baja lógica de máquina conserva historial",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          }
        ],
        "url": "{{baseUrl}}/maquinas/{{maquinaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "24. Máquina retirada no aparece en catálogo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "User-Agent",
            "value": "SILBOM-Postman/2.0"
          }
        ],
        "url": "{{baseUrl}}/maquinas/{{maquinaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
