# Java properties; Spring lo carga desde la raíz, sin comillas de shell.
# Copiar a .env, reemplazar marcadores y no versionar el archivo resultante.
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/silbom_db
DB_USERNAME=silbom_app
DB_PASSWORD=CAMBIAR_PASSWORD
# openssl rand -base64 32; conservar para leer notas anteriores.
ENCRYPTION_SECRET=CAMBIAR_BASE64_DE_32_BYTES
PLANTA_ID=PLANTA-SAN-JOAQUIN
# Solo si el frontend se sirve desde otro origen HTTPS; no usar comodines de red.
# SILBOM_CORS_ORIGINS=https://frontend.example.test
# Solo primera cuenta; quitar después. Sin contraseña predeterminada.
SILBOM_BOOTSTRAP_USERNAME=supervisor-local
SILBOM_BOOTSTRAP_PASSWORD=CAMBIAR_CONTRASENA_INICIAL
