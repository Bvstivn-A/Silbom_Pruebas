# ====================================================================
# EJEMPLO DE VARIABLES DE ENTORNO - SISTEMA SILBOM
# ====================================================================
# 1) Copia este archivo y llámalo ".env" (el .env NO se sube a Git).
# 2) Reemplaza cada valor "CAMBIAR_..." por el tuyo.
# NUNCA escribas claves reales en este archivo de ejemplo.

# Puerto HTTP de la aplicación
SERVER_PORT=8080

# Conexión a PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/silbom_db
DB_USERNAME=silbom_app
# Debe ser la misma contraseña que pusiste al crear el usuario en db/schema.sql
DB_PASSWORD=CAMBIAR_PASSWORD

# Clave para proteger POST, PUT y DELETE (el cliente la envía en el header X-API-KEY)
# Genérala con:  openssl rand -base64 32
APP_API_KEY=CAMBIAR_API_KEY

# Clave de cifrado AES-256 de las notas confidenciales. Debe ser Base64 de 32 bytes.
# Genérala con:  openssl rand -base64 32
ENCRYPTION_SECRET=CAMBIAR_CLAVE_DE_CIFRADO

# Identificador de la planta autorizada
PLANTA_ID=PLANTA-SAN-JOAQUIN
